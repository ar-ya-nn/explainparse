fn is_prime(n: int) -> bool {
    if (n < 2) {
        return false;
    }
    let d: int = 2;
    while (d * d <= n) {
        if (n % d == 0) {
            return false;
        }
        d = d + 1;
    }
    return true;
}

fn count_primes(limit: int) -> int {
    let count: int = 0;
    let i: int = 2;
    while (i <= limit) {
        if (is_prime(i)) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
